+// @vitest-environment jsdom
+/**
+ * Ordered locale preference: a stored list (or the legacy single string) is
+ * walked per key before English and the raw key, while the first registered
+ * entry stays the active interface language.
+ */
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+import { Context } from '@deepseek-ai/cordis'
+import { stubConfigForm, type StubConfigForm } from '@deepseek-ai/dsh-client-test-runtime'
+import type { LocaleSettings, LocaleSnapshot } from '@deepseek-ai/dsh-client-locale/client'
+import { LocaleRuntime } from '@deepseek-ai/dsh-client-locale/client'
+
+const stubLanguages = (...tags: string[]): void => {
+  vi.stubGlobal('navigator', { languages: tags, language: tags[0] ?? '' })
+}
+
+const make = (host?: StubConfigForm<LocaleSettings>): {
+  ctx: Context
+  svc: LocaleRuntime
+  events: LocaleSnapshot[]
+} => {
+  const ctx = new Context()
+  const events: LocaleSnapshot[] = []
+  ctx.on('locale/change', (snapshot) => { events.push(snapshot) })
+  return { ctx, svc: new LocaleRuntime(ctx, host?.scope), events }
+}
+
+describe('ordered locale preference', () => {
+  beforeEach(() => {
+    stubLanguages('zh-CN')
+  })
+
+  afterEach(() => {
+    vi.unstubAllGlobals()
+  })
+
+  it('reads a legacy stored string as a one-element preference', () => {
+    stubLanguages('en-US')
+    const { svc } = make()
+    expect(svc.getLocale().preference).toEqual(['en'])
+    expect(svc.getLocale().active).toBe('en')
+  })
+
+  it('walks the ordered preference before English and the raw key', () => {
+    const { svc } = make()
+    svc.addLanguage({ id: 'ja', label: '日本語', fallback: 'en' })
+    // Only zh owns this key; the ja chain (ja -> en) has no dictionary for it.
+    svc.register('ns', 'zh', { onlyZh: '中文のみ' })
+    const t = svc.bind('ns')
+    svc.setPreferences(['ja', 'zh'])
+    expect(t('onlyZh')).toBe('中文のみ')
+    svc.setPreferences(['ja'])
+    expect(t('onlyZh')).toBe('onlyZh')
+  })
+
+  it('answers from the earliest preferred language that owns the key', () => {
+    const { svc } = make()
+    svc.register('ns', 'zh', { hello: '你好' })
+    svc.register('ns', 'en', { hello: 'Hello' })
+    svc.addLanguage({ id: 'ja', label: '日本語', fallback: 'en' })
+    svc.register('ns', 'ja', { hello: 'こんにちは' })
+    const t = svc.bind('ns')
+    svc.setPreferences(['zh', 'ja', 'en'])
+    expect(t('hello')).toBe('你好')
+    svc.setPreferences(['ja', 'zh', 'en'])
+    expect(t('hello')).toBe('こんにちは')
+    expect(svc.getLocale().active).toBe('ja')
+  })
+
+  it('applies the ordered list to package text (resolveText)', () => {
+    const { svc } = make()
+    svc.addLanguage({ id: 'ja', label: '日本語', fallback: 'en' })
+    const text = { zh: '中文标题', ja: '日本語タイトル', en: 'English title' }
+    svc.setPreferences(['ja', 'zh'])
+    expect(svc.resolveText(text)).toBe('日本語タイトル')
+    svc.setPreferences(['zh', 'ja'])
+    expect(svc.resolveText(text)).toBe('中文标题')
+  })
+
+  it('persists the ordered list and still writes a legacy single string from setLocale', () => {
+    const host = stubConfigForm<LocaleSettings>()
+    const { svc } = make(host)
+    svc.setPreferences(['zh', 'en'])
+    expect(host.set).toHaveBeenLastCalledWith('preference', ['zh', 'en'])
+    svc.setLocale('en')
+    expect(host.set).toHaveBeenLastCalledWith('preference', 'en')
+    expect(svc.getLocale().preference).toEqual(['en'])
+  })
+
+  it('keeps the browser language order instead of narrowing to the first match', () => {
+    stubLanguages('ja-JP', 'zh-CN')
+    const { svc } = make()
+    svc.addLanguage({ id: 'ja', label: '日本語', fallback: 'en' })
+    expect(svc.getLocale().preference).toEqual(['ja', 'zh'])
+    expect(svc.getLocale().active).toBe('ja')
+  })
+
+  it('reorders without a locale/change event while the active language stays', () => {
+    const { svc, events } = make()
+    svc.setPreferences(['en', 'zh'])
+    expect(events).toHaveLength(1)
+    svc.setPreferences(['en'])
+    expect(events).toHaveLength(1)
+    svc.setPreferences(['zh', 'en'])
+    expect(events).toHaveLength(2)
+    expect(events[1]!.active).toBe('zh')
+  })
+
+  it('normalizes duplicates and rejects unknown or empty preferences', () => {
+    const { svc } = make()
+    svc.setPreferences(['EN', 'en'])
+    expect(svc.getLocale().preference).toEqual(['en'])
+    expect(() => { svc.setPreferences(['fr']) }).toThrow('not registered')
+    expect(() => { svc.setPreferences([]) }).toThrow('must not be empty')
+  })
+
+  it('adopts an ordered Host preference and follows later list updates', () => {
+    const host = stubConfigForm<LocaleSettings>()
+    const { svc } = make(host)
+    host.publish({ status: 'ready', value: { preference: ['zh', 'en'] }, revision: 1, writable: true })
+    expect(svc.getLocale().active).toBe('zh')
+    expect(svc.getLocale().preference).toEqual(['zh', 'en'])
+    host.publish({ status: 'ready', value: { preference: ['en', 'zh'] }, revision: 2, writable: true })
+    expect(svc.getLocale().active).toBe('en')
+    expect(svc.getLocale().preference).toEqual(['en', 'zh'])
+  })
+})
