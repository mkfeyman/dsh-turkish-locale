 /** Open locale identifier accepted from language-pack plugins. */
 export type LocaleId = string
 
+/**
+ * Ordered locale preference. The first registered entry is the active locale;
+ * later entries answer missing keys before the fallback chain and the raw key.
+ * A stored string is the legacy one-element form of the same value.
+ */
+export type LocalePreference = readonly LocaleId[]
+
+/**
+ * Normalize a stored preference to an ordered, duplicate-free list. A stored
+ * string is read as a one-element list; null and undefined stay absent.
+ * @param value - stored preference (legacy string, ordered list, null or undefined).
+ * @returns the normalized list, or undefined when nothing is stored.
+ */
+export function normalizeLocalePreference(
+  value: string | readonly string[] | null | undefined,
+): LocalePreference | undefined {
+  if (value === null || value === undefined) return undefined
+  const list = typeof value === 'string' ? [value] : value
+  const seen = new Set<string>()
+  const normalized: LocaleId[] = []
+  for (const id of list) {
+    const key = id.toLowerCase()
+    if (seen.has(key)) continue
+    seen.add(key)
+    normalized.push(id)
+  }
+  return normalized.length === 0 ? undefined : Object.freeze(normalized)
+}
