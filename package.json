{
  "name": "dsh-turkish-locale",
  "version": "1.0.0",
  "description": "Turkish (tr) language pack for the DeepSeek Harness web interface",
  "type": "module",
  "main": "lib/index.js",
  "engines": {
    "dsh": ">=0.2.1-rc.3 <0.3.0"
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "i18n",
    "localization",
    "turkish"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/mkfeyman/dsh-turkish-locale.git"
  },
  "homepage": "https://github.com/mkfeyman/dsh-turkish-locale"
}
